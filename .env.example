# Na Vercelu wystarczy podłączyć Upstash (Storage → Upstash). WSZYSTKO inne ustawiasz w panelu /panel.
# Poniższe zmienne są tylko zapasem – używane, gdy w panelu dane pole jest puste.

# Publiczny adres strony (bez ukośnika na końcu) – używany w linkach powrotu z SimPay
NEXT_PUBLIC_SITE_URL=https://dravon.pl

# SimPay → Konto Klienta → API (Bearer Token)
SIMPAY_API_KEY=
# SimPay → Płatności online → Usługi → ID usługi
SIMPAY_SERVICE_ID=
# SimPay → szczegóły usługi → Klucz IPN (do weryfikacji podpisu powiadomień)
SIMPAY_IPN_KEY=
# Dodatkowa weryfikacja IP nadawcy IPN (https://api.simpay.pl/ip). Włącz, jeśli serwer widzi prawdziwe IP klienta.
SIMPAY_VERIFY_IP=false

# Token, którym plugin DravonSklep pobiera zakupy (ten sam w plugins/DravonSklep/config.yml)
PLUGIN_TOKEN=

# Hasło do panelu sklepu (/panel) – produkty, ceny, komendy, zakupy. Długie i trudne!
ADMIN_PASSWORD=

# Adres serwera Minecraft do sprawdzania statusu/liczby graczy
MC_SERVER_ADDRESS=dravon.pl

# Magazyn zamówień. Domyślnie plik JSON w ./data (VPS / `next start`).
DATA_DIR=./data
# Na Vercelu wymagany Upstash Redis (Storage → Upstash dodaje KV_REST_API_URL/TOKEN sam) – wtedy plik nie jest używany.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
